<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpaceLens.Desktop.ViewModels"
             x:Class="SpaceLens.Desktop.Views.LargeFilesView"
             x:DataType="vm:LargeFilesViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Large Files" Classes="title" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding SelectedSize}" MinWidth="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SizeChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding Summary}" Classes="secondary" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}" />
    </DockPanel>
</UserControl>
