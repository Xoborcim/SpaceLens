<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceLens.App.ViewModels"
    xmlns:controls="using:SpaceLens.App.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="TreeRowTemplate" x:DataType="vm:EntryItem">
            <Grid Height="34" ColumnSpacing="8" AutomationProperties.Name="{x:Bind AutomationName}" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Grid Margin="{x:Bind Indent}" Width="28">
                    <Button
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind ChevronVisibility}"
                        Click="OnChevronClick"
                        IsTabStop="False"
                        AutomationProperties.Name="Expand or collapse">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" />
                    </Button>
                </Grid>
                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ItemsText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind BadgeVisibility}">
                    <TextBlock Text="{x:Bind BadgeText}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <Grid Grid.Column="4" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}">
                    <Border HorizontalAlignment="Left" Width="{x:Bind BarWidth, Mode=OneWay}" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <TextBlock Grid.Column="5" Text="{x:Bind PercentText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Folders" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="RootText" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Click="OnCollapseAll" ToolTipService.ToolTip="Collapse all" AutomationProperties.Name="Collapse all">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF165;" FontSize="14" /><TextBlock Text="Collapse all" /></StackPanel>
                </Button>
                <Button Click="OnScanFolder" IsEnabled="{x:Bind CanStartScan(State.IsScanning), Mode=OneWay}" AutomationProperties.Name="Scan folder">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8DA;" FontSize="14" /><TextBlock Text="Scan folder…" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0,4">
                <Grid>
                    <ListView
                        x:Name="TreeList"
                        ItemTemplate="{StaticResource TreeRowTemplate}"
                        SelectionMode="Extended"
                        SelectionChanged="OnSelectionChanged"
                        PreviewKeyDown="OnTreeKeyDown"
                        AutomationProperties.Name="Folder tree">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="Padding" Value="8,0,12,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Text="Scan a drive or folder to browse its contents." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <controls:DetailsPanel x:Name="Details" Grid.Column="1" ShowFoldersAction="False" />
        </Grid>
    </Grid>
</Page>
