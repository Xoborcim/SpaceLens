<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.ErrorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SpaceLens.Core.Models">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Inaccessible locations" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar
            Grid.Row="1"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Why some folders can't be read"
            Message="Windows protects some folders (other users' profiles, system data, some app containers). SpaceLens skips them and continues; their contents are not included in the totals. Running SpaceLens as administrator can read more of them, but it is never required." />
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0,4">
            <ListView x:Name="ErrorList" SelectionMode="Extended" AutomationProperties.Name="Inaccessible locations" ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ScanError">
                        <StackPanel Padding="0,6" ToolTipService.ToolTip="{x:Bind Path}">
                            <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Message}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy paths" Click="OnCopy">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Open parent folder" Click="OnOpenParent">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
        </Border>
    </Grid>
</Page>
