<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.DevFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpaceLens.App.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Dev Files" Style="{StaticResource PageTitleStyle}" />
            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap"
                Text="node_modules, build outputs (target, bin/obj, .next), virtual environments, package caches, and WSL, Docker or virtual machine disks. Most can be regenerated, which takes time and usually a network connection." />
        </StackPanel>
        <controls:FindingsView
            x:Name="Findings"
            Grid.Row="1"
            NoResultsMessage="No developer files were found. Build outputs, package caches, virtual environments and WSL or Docker disks appear here when present." />
    </Grid>
</Page>
