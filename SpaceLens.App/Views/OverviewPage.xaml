<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fs="using:SpaceLens.Windows.FileSystem"
    xmlns:controls="using:SpaceLens.App.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,20,32,32" Spacing="16" MaxWidth="1400">

            <!-- Header: drive picker and scan commands -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        x:Name="DrivePicker"
                        MinWidth="220"
                        ItemsSource="{x:Bind State.Drives}"
                        SelectedItem="{x:Bind State.SelectedDrive, Mode=TwoWay}"
                        SelectionChanged="OnDriveChanged"
                        AutomationProperties.Name="Drive">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="fs:DriveDescriptor">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="14" />
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                    <TextBlock Text="{x:Bind MediaLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ScanDriveButton" Style="{StaticResource AccentButtonStyle}" Click="OnScanDrive" IsEnabled="{x:Bind CanStartScan(State.IsScanning), Mode=OneWay}" AutomationProperties.Name="Scan drive">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock x:Name="ScanDriveText" Text="Scan drive" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnScanFolder" IsEnabled="{x:Bind CanStartScan(State.IsScanning), Mode=OneWay}" ToolTipService.ToolTip="Scan a single folder (Ctrl+L)" AutomationProperties.Name="Scan folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                            <TextBlock Text="Scan folder…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="SnapshotBar" Severity="Informational" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Rescan" Click="OnRescan" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Drive capacity -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid RowSpacing="10" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DriveName" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DriveSubtitle" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Used" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="UsedText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Free" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="FreeText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Total" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="TotalText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <ProgressBar x:Name="UsedBar" Grid.Row="1" Grid.ColumnSpan="4" Height="8" Maximum="1" AutomationProperties.Name="Used space" />
                </Grid>
            </Border>

            <!-- Not scanned yet -->
            <Border x:Name="EmptyCard" Style="{StaticResource CardStyle}" Padding="32">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEDA2;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock
                        MaxWidth="560"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="SpaceLens reads file sizes on this PC only. Nothing is uploaded, and nothing is changed until you choose an action and confirm it." />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Grid x:Name="ResultsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Largest categories" Style="{StaticResource SectionTitleStyle}" />
                        <ListView
                            x:Name="CategoryList"
                            ItemTemplate="{StaticResource SummaryRowTemplate}"
                            ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnCategoryClick"
                            AutomationProperties.Name="Largest categories" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Largest items" Style="{StaticResource SectionTitleStyle}" />
                        <ListView
                            x:Name="LargestList"
                            ItemTemplate="{StaticResource EntryRowTemplate}"
                            ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="OnLargestClick"
                            AutomationProperties.Name="Largest items" />
                    </StackPanel>
                </Border>

                <Border x:Name="OpportunitiesCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Where space can be recovered" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Margin="0,-4,0,8"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextWrapping="Wrap"
                            Text="Locations that usually contain removable data. Review each one first; SpaceLens explains what it is and the proper way to reduce it." />
                        <ListView
                            x:Name="OpportunityList"
                            ItemTemplate="{StaticResource SummaryRowTemplate}"
                            ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnOpportunityClick"
                            AutomationProperties.Name="Where space can be recovered" />
                        <TextBlock x:Name="AnalysisText" Style="{StaticResource SecondaryTextStyle}" Text="Analyzing…" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Map" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="MapColoring" Grid.Column="1" MinWidth="160" Margin="0,0,0,8" SelectionChanged="OnMapColoringChanged" AutomationProperties.Name="Colour the map by">
                                <ComboBoxItem Content="Colour by location" Tag="location" IsSelected="True" />
                                <ComboBoxItem Content="Colour by file type" Tag="type" />
                                <ComboBoxItem Content="Colour by age" Tag="age" />
                            </ComboBox>
                        </Grid>
                        <controls:TreemapControl x:Name="Treemap" Height="340" CellInvoked="OnTreemapCellInvoked" />
                        <StackPanel x:Name="MapLegend" Orientation="Horizontal" Spacing="16" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
