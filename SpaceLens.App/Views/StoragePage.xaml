<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpaceLens.App.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Storage Locations" Style="{StaticResource PageTitleStyle}" />
            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap"
                Text="Games, Windows-managed storage, caches, temporary files and other known locations. Each group explains what it contains and the proper way to reduce it." />
        </StackPanel>
        <controls:FindingsView x:Name="Findings" Grid.Row="1" NoResultsMessage="No known storage locations were found in this scan." />
    </Grid>
</Page>
