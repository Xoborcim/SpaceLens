<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Duplicates" Style="{StaticResource PageTitleStyle}" />
            <TextBlock
                x:Name="SummaryText"
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap"
                Text="Finds files of 1 MB or more with identical contents. Files are compared by size first, then by reading them, so only possible duplicates are read." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="FindButton" Style="{StaticResource AccentButtonStyle}" Click="OnFind">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock Text="Find duplicates" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Visibility="Collapsed" />
            <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Spacing="4" Width="320" Visibility="Collapsed">
                <ProgressBar x:Name="SearchProgress" Maximum="100" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0,4">
                <Grid>
                    <ListView
                        x:Name="GroupList"
                        ItemTemplate="{StaticResource SummaryRowTemplate}"
                        ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                        SelectionMode="Single"
                        SelectionChanged="OnGroupSelected"
                        AutomationProperties.Name="Groups of identical files" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="24"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0,4">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,10,16,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FilesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FilesNote" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="SelectCopiesButton"
                            Grid.Column="1"
                            Content="Select all but the first"
                            Click="OnSelectCopies"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Selects every copy except the first one in the list, ready to move to the Recycle Bin" />
                    </Grid>
                    <ListView
                        x:Name="FileList"
                        Grid.Row="1"
                        ItemTemplate="{StaticResource EntryRowTemplate}"
                        ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                        SelectionMode="Extended"
                        AutomationProperties.Name="Identical files" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
