<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.BasketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpaceLens.App.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Cleanup basket" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="RecycleAllButton" Style="{StaticResource AccentButtonStyle}" Click="OnRecycleAll">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Move all to Recycle Bin…" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveSelectedButton" Content="Take out of basket" Click="OnRemoveSelected" />
            <Button x:Name="ClearButton" Content="Empty basket" Click="OnClear" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0,4">
                <Grid>
                    <ListView
                        x:Name="ItemList"
                        ItemTemplate="{StaticResource EntryRowTemplate}"
                        ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                        SelectionMode="Extended"
                        SelectionChanged="OnSelectionChanged"
                        AutomationProperties.Name="Items in the cleanup basket" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="24"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="The basket is empty. Right-click files or folders on any page and choose Add to cleanup basket, then review and remove them here in one go." />
                </Grid>
            </Border>
            <controls:DetailsPanel x:Name="Details" Grid.Column="1" />
        </Grid>
    </Grid>
</Page>
