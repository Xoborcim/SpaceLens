<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceLens.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Changes" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="TotalsPanel" Grid.Row="1" Orientation="Horizontal" Spacing="32" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Net change" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="NetText" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Grew" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="GrownText" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Freed" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="FreedText" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0,4">
            <Grid>
                <ListView
                    x:Name="ChangeList"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                    DoubleTapped="OnDoubleTapped"
                    KeyDown="OnListKeyDown"
                    ContextRequested="OnContextRequested"
                    AutomationProperties.Name="Changes since the previous scan">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeItem">
                            <Grid Height="48" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <Grid Grid.Column="3" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}">
                                    <Border HorizontalAlignment="Left" Width="{x:Bind BarWidth}" CornerRadius="3" Background="{x:Bind DeltaBrush}" />
                                </Grid>
                                <TextBlock Grid.Column="4" Text="{x:Bind DeltaText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
                    <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
