<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="SpaceLens.App.Views.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceLens.App.ViewModels">

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DenseListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- File or folder row: icon, name + secondary line, badge, proportional bar, size. -->
    <DataTemplate x:Key="EntryRowTemplate" x:DataType="vm:EntryItem">
        <Grid Height="48" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}">
                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind BadgeVisibility}">
                <TextBlock Text="{x:Bind BadgeText}" Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
            <Grid Grid.Column="3" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}">
                <Border HorizontalAlignment="Left" Width="{x:Bind BarWidth, Mode=OneWay}" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>
            <TextBlock Grid.Column="4" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
    </DataTemplate>

    <!-- Summary row (categories, groups): swatch or glyph, name and count, size; the bar spans the row underneath. -->
    <DataTemplate x:Key="SummaryRowTemplate" x:DataType="vm:SummaryItem">
        <Grid Height="54" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Border Width="12" Height="12" CornerRadius="3" Background="{x:Bind Swatch}" />
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Visibility="{x:Bind HasNoSwatch}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind SubtitleText}" Style="{StaticResource SecondaryTextStyle}" />
                <ProgressBar Margin="0,4,0,0" Maximum="100" Value="{x:Bind BarWidth}" Foreground="{x:Bind BarBrush}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
