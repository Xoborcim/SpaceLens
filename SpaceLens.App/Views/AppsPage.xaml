<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceLens.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="AppRowTemplate" x:DataType="vm:AppItem">
            <Grid Height="52" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind InstallDateText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <Grid Grid.Column="3" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}" Visibility="{x:Bind BarVisibility}">
                    <Border HorizontalAlignment="Left" Width="{x:Bind BarWidth}" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind SizeText}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind SizeNote}" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Installed Apps" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" PlaceholderText="Filter apps" TextChanged="OnFilterChanged" AutomationProperties.Name="Filter apps" />
            <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="150" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort by">
                <ComboBoxItem Content="Largest first" Tag="size" IsSelected="True" />
                <ComboBoxItem Content="Name" Tag="name" />
                <ComboBoxItem Content="Recently installed" Tag="date" />
            </ComboBox>
            <ComboBox x:Name="KindBox" Grid.Column="2" MinWidth="150" SelectionChanged="OnSortChanged" AutomationProperties.Name="Show">
                <ComboBoxItem Content="All apps" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="Desktop apps" Tag="desktop" />
                <ComboBoxItem Content="Store apps" Tag="store" />
                <ComboBoxItem Content="Games" Tag="games" />
            </ComboBox>
            <ProgressRing x:Name="LoadingRing" Grid.Column="3" Width="20" Height="20" HorizontalAlignment="Left" IsActive="{x:Bind State.AppsLoading, Mode=OneWay}" />
            <Button Grid.Column="4" Click="OnRefresh" ToolTipService.ToolTip="Reload the list of installed apps" AutomationProperties.Name="Refresh">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0,4">
                <ListView
                    x:Name="AppList"
                    ItemTemplate="{StaticResource AppRowTemplate}"
                    ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnAppSelected"
                    AutomationProperties.Name="Installed apps" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="Select an app to see details" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="DetailsScroller" Visibility="Collapsed">
                        <StackPanel Padding="20" Spacing="14">
                            <StackPanel>
                                <TextBlock x:Name="AppName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="AppPublisher" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Measured on disk" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock x:Name="MeasuredSize" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="MeasuredNote" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Reported by the app" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock x:Name="ReportedSize" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="FactsGrid" ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <StackPanel Spacing="8">
                                <Button x:Name="UninstallButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnUninstall" AutomationProperties.Name="Uninstall">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Uninstall…" /></StackPanel>
                                </Button>
                                <Button x:Name="QuietUninstallButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnQuietUninstall" AutomationProperties.Name="Quiet uninstall">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Quiet uninstall…" /></StackPanel>
                                </Button>
                                <Button x:Name="OpenFolderButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnOpenFolder" AutomationProperties.Name="Open install folder">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock Text="Open install folder" /></StackPanel>
                                </Button>
                                <Button x:Name="OpenDataButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnOpenData" AutomationProperties.Name="Open data folder">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock Text="Open data folder" /></StackPanel>
                                </Button>
                                <Button x:Name="ShowInFoldersButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnShowInFolders" AutomationProperties.Name="Show in Folders">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14" /><TextBlock Text="Show in Folders" /></StackPanel>
                                </Button>
                            </StackPanel>

                            <InfoBar x:Name="UninstallStatus" IsClosable="True" />

                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                TextWrapping="Wrap"
                                Text="Uninstall runs the program's own uninstaller (or Windows' package manager for Store apps). SpaceLens never deletes program folders directly." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
