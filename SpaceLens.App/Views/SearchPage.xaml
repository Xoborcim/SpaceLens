<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SpaceLens.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpaceLens.App.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Search" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0,4">
                <Grid>
                    <ListView
                        x:Name="ResultList"
                        ItemTemplate="{StaticResource EntryRowTemplate}"
                        ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                        SelectionMode="Extended"
                        SelectionChanged="OnSelectionChanged"
                        AutomationProperties.Name="Search results" />
                    <StackPanel x:Name="HelpPanel" Spacing="6" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Search the scan results" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="steam                 names containing &quot;steam&quot;" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text=".iso                     files with that extension" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="*.vmdk                 wildcard patterns" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="node_modules      folders by name" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="&gt;5GB                    size filters (&lt; and &gt;)" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="type:video          file types" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="older:1y              files not modified in a year (d, w, m, y or a date)" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="newer:30d           files modified in the last 30 days" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Files smaller than 1 MB are not indexed individually." Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <controls:DetailsPanel x:Name="Details" Grid.Column="1" />
        </Grid>
    </Grid>
</Page>
