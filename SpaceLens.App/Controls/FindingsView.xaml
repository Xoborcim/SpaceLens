<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceLens.App.Controls.FindingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpaceLens.App.Controls">

    <Grid x:Name="LayoutRoot" ColumnSpacing="16" SizeChanged="OnLayoutSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="0,4">
            <Grid>
                <ListView
                    x:Name="GroupList"
                    ItemTemplate="{StaticResource SummaryRowTemplate}"
                    ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnGroupSelected"
                    AutomationProperties.Name="Groups" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0,4">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Padding="16,10,16,4" Spacing="8">
                    <TextBlock x:Name="GroupTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="GroupExplanation" TextWrapping="Wrap" />
                    <InfoBar x:Name="GroupAdvice" IsClosable="False" Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Name="GroupActionButton" Click="OnGroupAction" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <ListView
                    x:Name="ItemList"
                    Grid.Row="1"
                    ItemTemplate="{StaticResource EntryRowTemplate}"
                    ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                    SelectionMode="Extended"
                    SelectionChanged="OnItemSelected"
                    AutomationProperties.Name="Locations" />
                <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="12" x:Name="SelectionBar" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RevealSelectedButton" Click="OnRevealSelected" AutomationProperties.Name="Open in Explorer" ToolTipService.ToolTip="Open in Explorer">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                        </Button>
                        <Button x:Name="ItemActionButton" Click="OnItemAction" />
                        <Button x:Name="RecycleSelectedButton" Click="OnRecycleSelected" AutomationProperties.Name="Move selected to Recycle Bin">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Move to Recycle Bin…" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <controls:DetailsPanel x:Name="Details" Grid.Column="2" />
    </Grid>
</UserControl>
