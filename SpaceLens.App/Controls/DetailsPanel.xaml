<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceLens.App.Controls.DetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
            <StackPanel x:Name="EmptyState" Padding="20" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Select an item to see details" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="DetailsContent" Visibility="Collapsed">
                <StackPanel Padding="20" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="IconGlyph" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SizeValue" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="TypeValue" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="NameValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="PathValue" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid x:Name="FactsGrid" ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <InfoBar x:Name="SafetyInfo" IsClosable="False" />
                    <InfoBar x:Name="FindingInfo" IsClosable="False" Severity="Informational" />

                    <StackPanel x:Name="Actions" Spacing="8">
                        <Button x:Name="OpenButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnOpen" AutomationProperties.Name="Open">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock Text="Open" /></StackPanel>
                        </Button>
                        <Button x:Name="RevealButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnReveal" AutomationProperties.Name="Open in Explorer">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock x:Name="RevealText" Text="Open in Explorer" /></StackPanel>
                        </Button>
                        <Button x:Name="FoldersButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnShowInFolders" AutomationProperties.Name="Show in Folders">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14" /><TextBlock Text="Show in Folders" /></StackPanel>
                        </Button>
                        <Button x:Name="ActionButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnFindingAction">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="14" /><TextBlock x:Name="ActionText" /></StackPanel>
                        </Button>
                        <Button x:Name="UninstallButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnUninstall">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock x:Name="UninstallText" /></StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnCopyPath" AutomationProperties.Name="Copy path">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy path" /></StackPanel>
                        </Button>
                        <Button x:Name="RecycleButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnRecycle" AutomationProperties.Name="Move to Recycle Bin">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Move to Recycle Bin…" /></StackPanel>
                        </Button>
                        <HyperlinkButton x:Name="WhyButton" Content="Why can't this be removed?" Click="OnWhy" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
